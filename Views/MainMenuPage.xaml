<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Reader.ViewModels"
             xmlns:m="clr-namespace:Reader.Models"
             x:Class="Reader.Views.MainMenuPage"
             x:DataType="vm:MainMenuViewModel">

    <Grid RowDefinitions="Auto,*" Padding="16,12">
        <!-- Top bar: title + sign-in + theme toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <Label Text="Reader" Style="{StaticResource Title}" VerticalOptions="Center" />
            <Button Grid.Column="1" Style="{StaticResource Icon}" Text="&#x1F511;"
                    Command="{Binding SignInCommand}" IsVisible="{Binding SignedIn, Converter={StaticResource Not}}" />
            <Button Grid.Column="2" Style="{StaticResource Icon}" Text="&#x25D0;" Command="{Binding ToggleThemeCommand}" />
        </Grid>

        <!-- Library grid (adaptive span set in code-behind on resize). -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding Busy}">
            <CollectionView x:Name="Grid" ItemsSource="{Binding Novels}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Webnovel">
                        <Border Style="{StaticResource CardFrame}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainMenuViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="*,Auto">
                                <!-- Lazy-loaded cover with placeholder fallback -->
                                <Image Source="{Binding DisplayCover, Converter={StaticResource Cover}}"
                                       Aspect="AspectFill" HeightRequest="180" />
                                <VerticalStackLayout Grid.Row="1" Padding="10" Spacing="3">
                                    <Label Text="{Binding Title}" MaxLines="1" LineBreakMode="TailTruncation" FontSize="14" />
                                    <Label Text="{Binding EpCount, StringFormat='{0} episodes'}" Style="{StaticResource Muted}" />
                                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource Accent}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Empty state: animated icon + French copy from the spec -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="14" IsVisible="{Binding Empty}">
            <Label x:Name="EmptyIcon" Text="&#x1F50D;" FontSize="64" HorizontalOptions="Center" />
            <Label Text="Il n'y a rien à écouter ici..." Style="{StaticResource Muted}" FontSize="16" />
        </VerticalStackLayout>

        <!-- Add (FAB) -->
        <Button Grid.Row="1" Text="+" FontSize="30" CornerRadius="30" WidthRequest="60" HeightRequest="60"
                HorizontalOptions="End" VerticalOptions="End" Margin="0,0,8,8" Command="{Binding AddCommand}" />
    </Grid>
</ContentPage>
