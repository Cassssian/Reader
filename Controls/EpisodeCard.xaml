<?xml version="1.0" encoding="UTF-8" ?>
<!-- Reusable episode tile. BindingContext is an Episode (set by the parent DataTemplate). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Reader.Controls.EpisodeCard">
    <Border Style="{StaticResource CardFrame}" Padding="12" HeightRequest="74">
        <Grid RowDefinitions="Auto,*" RowSpacing="2">
            <Label Text="{Binding Number}" Style="{StaticResource Muted}" />
            <Label Grid.Row="1" Text="{Binding Title}" MaxLines="2" LineBreakMode="TailTruncation" FontSize="13" />
            <!-- per-episode reading progress -->
            <ProgressBar Grid.Row="1" VerticalOptions="End" Progress="{Binding Progress}"
                         ProgressColor="{StaticResource Accent}" />
        </Grid>
    </Border>
</ContentView>
