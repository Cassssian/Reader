<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#6C5CE7</Color>
    <Color x:Key="Accent">#00D2D3</Color>

    <!-- Dark palette (default) -->
    <Color x:Key="Bg">#0D1117</Color>
    <Color x:Key="Surface">#161B22</Color>
    <Color x:Key="Card">#1C2330</Color>
    <Color x:Key="Text">#E6EDF3</Color>
    <Color x:Key="Muted">#8B949E</Color>
    <Color x:Key="MutedColor">#8B949E</Color>

    <!-- Light palette -->
    <Color x:Key="BgLight">#F5F6FA</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="TextLight">#1A1A2E</Color>
    <Color x:Key="MutedLight">#6E7781</Color>

    <Color x:Key="Highlight">#FFE08A</Color>
</ResourceDictionary>
